{
  "name": "shuoshuo-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "generate": "node scripts/generate-api-docs.ts",
    "build": "pnpm generate && next build",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "sync:openapi": "node scripts/sync-openapi.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "12.5.5",
    "fumadocs-ui": "16.17.8",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
